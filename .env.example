# Supabase Configuration
# Add your actual values to .env.local (not committed to git)

# Your Supabase project URL
# Example: https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_url_here

# Your Supabase anonymous/public key
# This is safe to expose in the frontend
# Security is enforced through Row Level Security (RLS) policies
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Public origin used to build shared prompt links (no trailing slash).
# Optional: falls back to the current origin, which in development means
# localhost URLs that recipients — and Facebook, LinkedIn and Pinterest —
# cannot open. Set it to the deployed URL to test sharing locally.
# Example: https://parostudio.vercel.app
VITE_SITE_URL=

# Supabase Edge Function Configuration (Backend Only)
# These are NOT exposed to the frontend—set them in Supabase dashboard
# 
# For the send-feedback-email Edge Function:
# 1. Go to Supabase Dashboard > Settings > Edge Functions
# 2. Add these secrets:
#
# RESEND_API_KEY: Get from https://resend.com
#   - Sign up or log in to Resend
#   - Generate an API key
#   - Format: re_xxxxxxxxxxxxxxxxxxxx
#
# FEEDBACK_EMAIL_FROM: A verified sender email in Resend
#   - Must be a domain you own or a Resend subdomain
#   - Example: noreply@parostudio.com
#   - Or use default: onboarding@resend.dev (for testing only)
